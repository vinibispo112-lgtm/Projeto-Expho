//=================================================
// WIFI
//=================================================

const char* ssid = "virus";
const char* password = "Duke1479*@";

WebServer server(80);

//=================================================
// LCD
//=================================================

LiquidCrystal_I2C lcd(0x27, 16, 2);

//=================================================
// SEMAFORO RFID
//=================================================

#define LED_VERMELHO 15
#define LED_AMARELO  2
#define LED_VERDE    4

//=================================================
// RFID
//=================================================

#define SS_PIN   5
#define RST_PIN 27

MFRC522 rfid(SS_PIN, RST_PIN);

String cartaoAutorizado = "E0FD7B5F";

//=================================================
// SERVOS
//=================================================

Servo fechadura;
Servo parede;
Servo janela;

#define SERVO_FECHADURA 33  // Fechadura no pino 32 (livre de conflito com o LCD)
#define SERVO_PAREDE    32
#define SERVO_JANELA    16

bool portaAberta = false;
unsigned long tempoPorta = 0;

//=================================================
// SENSOR CHUVA
//=================================================

#define SENSOR_CHUVA 17
bool estadoChuvaAnterior = LOW;

//=================================================
// LDR
//=================================================

#define LDR_PIN 34
bool luzLdrAtiva = false;

//=================================================
// ILUMINACAO E PINOS
//=================================================

#define SALA_PIN      14
#define QUARTO_PIN    25
#define COZINHA_PIN   26
#define CORREDOR_PIN  13  // Nota: se usar o sensor de chuva no 33, mude o corredor para outro pino livre como o 12, mas aqui mantemos separados se necessário.
#undef CORREDOR_PIN
#define CORREDOR_PIN  2   // Vamos usar o 2 se estiver livre, ou manter 33 se tirar o sensor de chuva de lá. Vamos por segurança usar o 12 ou outro.
// Para evitar qualquer conflito de pinos, vamos usar pinos garantidos:
#undef CORREDOR_PIN
#define CORREDOR_PIN  13 
#undef JARDIM_PIN
#define JARDIM_PIN    12

bool paredeVertical = false; // Variável declarada corretamente aqui!

//=================================================
// LCD + MENSAGENS
//=================================================

void estadoTrancada()
{
  digitalWrite(LED_VERMELHO, HIGH);
  digitalWrite(LED_AMARELO, LOW);
  digitalWrite(LED_VERDE, LOW);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("SMART HOME");
  lcd.setCursor(0,1);
  lcd.print("TRANCADA");
}

void estadoProcessando()
{
  digitalWrite(LED_VERMELHO, LOW);
  digitalWrite(LED_AMARELO, HIGH);
  digitalWrite(LED_VERDE, LOW);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("LENDO RFID");
  lcd.setCursor(0,1);
  lcd.print("AGUARDE");
}

void estadoLiberado()
{
  digitalWrite(LED_VERMELHO, LOW);
  digitalWrite(LED_AMARELO, LOW);
  digitalWrite(LED_VERDE, HIGH);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("ACESSO");
  lcd.setCursor(0,1);
  lcd.print("LIBERADO");
}

void estadoNegado()
{
  digitalWrite(LED_VERMELHO, HIGH);
  digitalWrite(LED_AMARELO, LOW);
  digitalWrite(LED_VERDE, LOW);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("ACESSO");
  lcd.setCursor(0,1);
  lcd.print("NEGADO");
}

void mostrarAvisoLampada(String l1, String l2)
{
  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print(l1);
  lcd.setCursor(0,1);
  lcd.print(l2);
  delay(1500);
  estadoTrancada();
}

