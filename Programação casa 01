//=================================================
// RFID
//=================================================

void verificarRFID()
{
  if (!rfid.PICC_IsNewCardPresent())
    return;

  if (!rfid.PICC_ReadCardSerial())
    return;

  estadoProcessando();

  String uid = "";
  for(byte i=0; i<rfid.uid.size; i++)
  {
    uid += String(rfid.uid.uidByte[i], HEX);
  }
  uid.toUpperCase();

  Serial.print("[RFID] Cartão detectado. UID: ");
  Serial.println(uid);

  delay(1000);

  if(uid == cartaoAutorizado)
  {
    estadoLiberado();
    fechadura.write(90);
    portaAberta = true;
    tempoPorta = millis();
    Serial.println("[RFID] Acesso LIBERADO!");
  }
  else
  {
    estadoNegado();
    Serial.println("[RFID] Acesso NEGADO!");
    delay(3000);
    estadoTrancada();
  }

  rfid.PICC_HaltA();
}

//=================================================
// FECHADURA
//=================================================

void controlarFechadura()
{
  if(portaAberta)
  {
    if(millis() - tempoPorta >= 5000)
    {
      fechadura.write(0);
      portaAberta = false;
      estadoTrancada();
      Serial.println("[FECHADURA] Trancada automaticamente.");
    }
  }
}

//=================================================
// JANELA
//=================================================

void controlarJanela()
{
  int chuva = digitalRead(SENSOR_CHUVA);

  if(chuva != estadoChuvaAnterior)
  {
    estadoChuvaAnterior = chuva;
    if(chuva == HIGH)
    {
      janela.write(90);
      Serial.println("[CHUVA] Sensor detectou CHUVA! Janela fechada.");
      mostrarAvisoLampada("CHUVA DETECTADA", "JANELA FECHADA");
    }
    else
    {
      janela.write(0);
      Serial.println("[CHUVA] Parou de chover. Janela aberta.");
      mostrarAvisoLampada("TEMPO FIRME", "JANELA ABERTA");
    }
  }
}

//=================================================
// LDR
//=================================================

void controlarLDR()
{
  int leitura = analogRead(LDR_PIN);

  if(leitura < 1500 && !luzLdrAtiva)
  {
    digitalWrite(CORREDOR_PIN, HIGH);
    digitalWrite(JARDIM_PIN, HIGH);
    luzLdrAtiva = true;
    Serial.print("[LDR] Escuro. Ligando luzes (Leitura: ");
    Serial.print(leitura);
    Serial.println(").");
    mostrarAvisoLampada("MODO NOITE", "LUZES ATIVADAS");
  }
  else if(leitura >= 1500 && luzLdrAtiva)
  {
    luzLdrAtiva = false;
    Serial.print("[LDR] Claro (Leitura: ");
    Serial.print(leitura);
    Serial.println(").");
  }
}

//=================================================
// SETUP
//=================================================

void setup()
{
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n[SISTEMA] Iniciando ESP32 Smart Home...");

  pinMode(SALA_PIN, OUTPUT);
  pinMode(QUARTO_PIN, OUTPUT);
  pinMode(COZINHA_PIN, OUTPUT);
  pinMode(CORREDOR_PIN, OUTPUT);
  pinMode(JARDIM_PIN, OUTPUT);

  pinMode(SENSOR_CHUVA, INPUT);

  pinMode(LED_VERMELHO, OUTPUT);
  pinMode(LED_AMARELO, OUTPUT);
  pinMode(LED_VERDE, OUTPUT);

  lcd.init();
  lcd.backlight();

  estadoTrancada();

  fechadura.attach(SERVO_FECHADURA);
  parede.attach(SERVO_PAREDE);
  janela.attach(SERVO_JANELA);

  fechadura.write(0);
  parede.write(0);
  janela.write(0);

  SPI.begin();
  rfid.PCD_Init();

  Serial.print("[WIFI] Conectando à rede: ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while(WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("[WIFI] Conectado com sucesso!");
  Serial.print("[WIFI] Endereço IP do Servidor Web: http://");
  Serial.println(WiFi.localIP());

  server.on("/", paginaPrincipal);

  server.on("/salaon", salaON);
  server.on("/salaoff", salaOFF);

  server.on("/quartoon", quartoON);
  server.on("/quartooff", quartoOFF);

  server.on("/cozinhaon", cozinhaON);
  server.on("/cozinhaoff", cozinhaOFF);

  server.on("/corredoron", corredorON);
  server.on("/corredoroff", corredorOFF);

  server.on("/jardimon", jardimON);
  server.on("/jardimoff", jardimOFF);

  server.on("/horizontal", paredeHorizontal);
  server.on("/vertical", paredeVerticalFunc);

  server.begin();
  Serial.println("[WEB] Servidor Web iniciado na porta 80!");
}

//=================================================
// LOOP
//=================================================

void loop()
{
  server.handleClient();
  verificarRFID();
  controlarFechadura();
  controlarJanela();
  controlarLDR();
}
